+    /// A button shows fill on this frame (hidden or empty reads 0).
+    private static func fills(_ s: [Double], _ b: Int) -> Bool { s[b] > 0.02 }
+
+    /// The first frame your buttons faded in by the read at `t`. Walking back the fill only falls
+    /// (a frame may dip) to an empty frame before they showed. A fuller frame first is the stop's
+    /// effects, and no empty frame by `floor` no edge: unknown.
+    private func buttonsFadedIn(by t: TimeInterval, after floor: TimeInterval) -> TimeInterval? {
+        let frames = fillSamples.filter { $0[0] > floor && $0[0] <= t }
+        guard var i = frames.indices.last, Self.fills(frames[i], 1) || Self.fills(frames[i], 2) else { return nil }
+        while i > 0 {
+            let earlier = frames[i - 1], later = frames[i...].prefix(2)
+            if !Self.fills(earlier, 1) && !Self.fills(earlier, 2) { return frames[i][0] }
+            if (1...2).contains(where: { b in earlier[b] > later.map { $0[b] }.max()! + 0.1 }) { return nil }
+            i -= 1
+        }
+        return nil
+    }
+
+    /// The first frame your buttons were gone by the first read without them: a button showing
+    /// fill at the last read with them, empty on two frames in a row after it (the stop's effects
+    /// may follow). Unknown if neither did.
+    private func buttonsVanished(by first: TimeInterval, after previous: TimeInterval) -> TimeInterval? {
+        guard let shown = fillSamples.last(where: { $0[0] <= previous }) else { return nil }
+        let frames = fillSamples.filter { $0[0] > previous }
+        return (1...2).compactMap { b -> TimeInterval? in
+            guard Self.fills(shown, b) else { return nil }
+            return frames.indices.first { i in
+                frames[i][0] <= first && !Self.fills(frames[i], b) && i + 1 < frames.count && !Self.fills(frames[i + 1], b)
+            }.map { frames[$0][0] }
+        }.min()
+    }
+
     private func yourLandings(from start: TimeInterval, to end: TimeInterval) -> [TimeInterval] {
         YourFastMoves.landings(in: fillSamples.filter { $0[0] >= start && $0[0] <= end })
     }
