+    /// The frame your buttons vanished on: the start of the run of frames with a button empty (as
+    /// hidden ones read) through the first read without them, if after the last read with them.
+    /// A shorter run is flicker.
+    private func vanishFrame(after previous: TimeInterval, by first: TimeInterval) -> TimeInterval? {
+        let empty = { (s: [Double]) in min(s[1], s[2]) <= 0.02 }
+        guard let j = fillSamples.lastIndex(where: { $0[0] <= first }), fillSamples[j][0] > previous, empty(fillSamples[j]) else { return nil }
+        var start = j, end = j
+        while start > 0, empty(fillSamples[start - 1]) { start -= 1 }
+        while end + 1 < fillSamples.count, empty(fillSamples[end + 1]) { end += 1 }
+        guard start > 0, fillSamples[start][0] > previous, fillSamples[end][0] - fillSamples[start][0] >= 0.1 else { return nil }
+        return fillSamples[start][0]
+    }
+
+    /// Your charged move waits for your fast move in progress at the tap: it lands one of your fast
+    /// moves after the last one your buttons showed, if none was missed since (a full one can't rise).
+    private func yourFreeze(tap: TimeInterval) -> TimeInterval? {
+        guard let move = yourFastMove, let last = yourLandings(from: buttonsResumedAt, to: tap).last, tap - last <= move else { return nil }
+        return last + move + freezeAfterLanding
+    }
+
     /// The gaps between your fast moves landing in a stretch of play tell your fast move's length.
